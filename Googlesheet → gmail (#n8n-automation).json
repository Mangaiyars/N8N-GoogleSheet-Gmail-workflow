      "parameters": {
        "jsCode": "const clean = v => String(v ?? '').trim();\n\nconst rows = $input.all()\n  .map(item => item.json)\n  .filter(r => clean(r.DemandID) !== '');\n\nif (rows.length === 0) {\n  return [{ json: { hasData: false, rowCount: 0 } }];\n}\n\nconst esc = v => clean(v).replace(/[&<>\"]/g, c =>\n  ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\n\nconst cell = 'padding:8px 12px;border:1px solid #ddd;';\nconst headers = ['Date-created', 'DemandID', 'Primary skill', 'Region', 'Location-type', 'Location', 'Status'];\n\nconst headerHtml = headers.map(h => `<th style=\"${cell}\">${h}</th>`).join('');\nconst rowsHtml = rows.map(r =>\n  `<tr>${headers.map(h => `<td style=\"${cell}\">${esc(r[h])}</td>`).join('')}</tr>`\n).join('');\n\nconst counts = {};\nrows.forEach(r => { const s = clean(r.Status); counts[s] = (counts[s] || 0) + 1; });\nconst summary = Object.entries(counts).map(([s, n]) => `${s}: ${n}`).join(' | ');\n\nconst body = `\n<div style=\"font-family:Arial,sans-serif;font-size:14px;color:#222;\">\n  <p>Hi,</p>\n  <p>Here is the latest demand status (${rows.length} open demands).</p>\n  <p><b>Summary:</b> ${esc(summary)}</p>\n  <table style=\"border-collapse:collapse;\">\n    <thead style=\"background:#f2f2f2;\"><tr>${headerHtml}</tr></thead>\n    <tbody>${rowsHtml}</tbody>\n  </table>\n  <p>Regards,<br>Your Automation Bot</p>\n</div>`;\n\nreturn [{\n  json: {\n    hasData: true,\n    rowCount: rows.length,\n    subject: `Demand Status Update – ${rows.length} demands – ${$now.toFormat('dd LLL yyyy')}`,\n    body\n  }\n}];"
      },
